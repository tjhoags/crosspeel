{
  "name": "crosspeel",
  "compatibility_date": "2026-09-04",
  "main": "./src/worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/evidence/*"]
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "crosspeel-artifacts"
    }
  ],
  "routes": [
    {
      "pattern": "crosspeel.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
